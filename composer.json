{
    "name": "otago/shared-cms-sync",
    "description": "Shared CMS sync engine: pulls content from a SilverStripe GraphQL endpoint into snapshots, then maps those snapshots onto local records",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Jeffrey Dick",
            "email": "jeffrey.dick@op.ac.nz"
        }
    ],
    "require": {
        "php": ">=8.3",
        "silverstripe/framework": "^6",
        "silverstripe/versioned": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "Otago\\SharedCmsSync\\": "src/",
            "Otago\\SharedCmsSync\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "expose": [
            "client"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
